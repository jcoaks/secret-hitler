{
  "name": "secret-hitler",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "pnpm --parallel --filter @sh/server --filter @sh/web dev",
    "build": "pnpm --filter @sh/web build",
    "e2e": "pnpm --filter @sh/e2e test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2"
  }
}
