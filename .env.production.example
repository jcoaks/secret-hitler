# PostgreSQL Configuration
POSTGRES_USER=secrethitler_user
POSTGRES_PASSWORD=TU_PASSWORD_SEGURO_AQUI
POSTGRES_DB=secrethitler

# Backend Configuration
DATABASE_URL=postgres://secrethitler_user:TU_PASSWORD_SEGURO_AQUI@db:5432/secrethitler
PORT=4040
DEBUG_MODE=false

# Domain Configuration
DOMAIN=secrethitler.lat

# Email for SSL certificates
SSL_EMAIL=tu-email@ejemplo.com

# Java Options
JAVA_OPTS=-Xmx512m -Xms256m

# Node Environment
NODE_ENV=production
