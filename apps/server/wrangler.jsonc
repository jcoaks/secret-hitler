{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "secret-hitler",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true },
  // secrethitler.lat is in the same Cloudflare account. Custom domains need the hostname free of
  // other DNS records (the old A record to Lightsail must be removed before the first deploy).
  "routes": [
    { "pattern": "secrethitler.lat", "custom_domain": true },
    { "pattern": "www.secrethitler.lat", "custom_domain": true }
  ],
  "workers_dev": true,
  // The web app (apps/web, built with `pnpm --filter @sh/web build`) is served as static
  // assets; only /api/* reaches the Worker first. Unknown paths fall back to index.html.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
