# Build stage
FROM node:18 AS build
WORKDIR /app

ARG REACT_APP_DEBUG=PRODUCTION
ARG REACT_APP_SERVER_ADDRESS=secrethitler.lat
ARG REACT_APP_SERVER_ADDRESS_HTTP=https://secrethitler.lat
ARG REACT_APP_WEBSOCKET_HEADER=wss://

ENV REACT_APP_DEBUG=$REACT_APP_DEBUG
ENV REACT_APP_SERVER_ADDRESS=$REACT_APP_SERVER_ADDRESS
ENV REACT_APP_SERVER_ADDRESS_HTTP=$REACT_APP_SERVER_ADDRESS_HTTP
ENV REACT_APP_WEBSOCKET_HEADER=$REACT_APP_WEBSOCKET_HEADER

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Production stage
FROM nginx:alpine
WORKDIR /usr/share/nginx/html

# Remove default nginx static assets
RUN rm -rf ./*

# Copy built assets from build stage
COPY --from=build /app/build .

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
